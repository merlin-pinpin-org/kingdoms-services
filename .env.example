# Discord
DISCORD_TOKEN=your_discord_bot_token_here

# Bot admins: comma-separated Discord user IDs (kingdoms-services#35).
# In CI/CD and deployments, provide via the BOT_ADMINS GitHub secret.
BOT_ADMINS=

# Deployed-artifact link shown by /status (kingdoms-infra#37):
# PR URL for a /deploy-test deploy, commit URL for a main deploy,
# release URL for prod. Injected by the deploy pipeline; empty locally.
KINGDOMS_DEPLOY_URL=

TEST_DISCORD_TOKEN=your_test_bot_token_here
TEST_GUILD_ID=your_test_guild_id_here

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB=kingdoms

# Redis
REDIS_URI=redis://localhost:6379

# Logging
LOG_LEVEL=INFO
